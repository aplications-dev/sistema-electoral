embed-server --server-config=standalone.xml --std-out=echo
data-source add --name=ControlDS --jndi-name=java:/ControlDS --driver-name=postgresql-42.7.3.jar --connection-url=${env.DB_URL:jdbc:postgresql://localhost:5432/postgres} --user-name=${env.DB_USER:postgres} --password=${env.DB_PASS:postgres} --use-ccm=true --max-pool-size=10 --blocking-timeout-wait-millis=5000 --enabled=true
stop-embedded-server
